# Database (Postgres)
# - Local docker compose: postgres://seo:seo@postgres:5432/seo
# - Fly Postgres: copy the connection URL from `flyctl postgres connect`
DATABASE_URL=postgres://seo:seo@localhost:5432/seo

# Redis for BullMQ — local docker compose, Upstash, or Fly Redis all work.
REDIS_URL=redis://localhost:6379

# DataForSEO upstream credentials (https://app.dataforseo.com/api-access)
DATAFORSEO_LOGIN=your-login
DATAFORSEO_PASSWORD=your-password

# Bearer token gate for /api/v1 routes. Generate with: openssl rand -hex 32
SEO_INTEL_API_KEY=replace-with-a-strong-random-string

# Server config
PORT=3000
NODE_ENV=development
